
#pragma parameter SAT "Saturation" 1.0 0.0 2.0 0.05
#pragma parameter SOFTEN "S-Video Blur" 0.85 0.0 1.0 0.05

uniform float SAT    = 1.0;
uniform float SOFTEN = 0.85;

struct input
{
    float2 video_size;
    float2 texture_size;
    float2 output_size;
    float frame_count;
    float frame_direction;
};

struct out_vertex
{
    float4 position : POSITION;
    float4 color    : COLOR;
    float2 texCoord : TEXCOORD0;
};

out_vertex main_vertex
(
    float4 position : POSITION,
    float4 color    : COLOR,
    float2 texCoord : TEXCOORD0,
    uniform float4x4 modelViewProj
)
{
    out_vertex OUT;
    OUT.position = mul(modelViewProj, position);
    OUT.color    = color;
    OUT.texCoord = texCoord;
    return OUT;
}

float4 main_fragment
(
    in out_vertex VAR,
    uniform sampler2D decal : TEXUNIT0,
    uniform input IN
) : COLOR
{
    float video_w = IN.video_size.x;
    float video_h = IN.video_size.y;
    float tex_w   = IN.texture_size.x;
    float tex_h   = IN.texture_size.y;

    float r_x = video_w / tex_w;
    float r_y = video_h / tex_h;

    // image-normalised 0..1 coords
    float u = VAR.texCoord.x / r_x;
    float v = VAR.texCoord.y / r_y;
    float step_x = 1.0 / video_w;

    // tap L / center / R in padded TEXCOORD space
    float uL = (u - step_x) * r_x;
    float uR = (u + step_x) * r_x;
    float uC = u * r_x;
    float vT = v * r_y;
    float2 tL = float2(uL, vT);
    float2 tR = float2(uR, vT);
    float2 tC = float2(uC, vT);

    float3 b = tex2D(decal, tL).rgb;
    float3 c0 = tex2D(decal, tR).rgb;
    float3 d0 = tex2D(decal, tC).rgb;

    float w0 = 0.5 + 0.5 * (1.0 - SOFTEN);
    float w1 = 0.25 * SOFTEN;
    float3 blur = float3(
        d0.r * w0 + b.r * w1 + c0.r * w1,
        d0.g * w0 + b.g * w1 + c0.g * w1,
        d0.b * w0 + b.b * w1 + c0.b * w1);
    float3 rgb = lerp(d0, blur, SOFTEN);

    // RGB -> YUV (BT.601)
    float yy =  0.299   * rgb.r + 0.587   * rgb.g + 0.114   * rgb.b;
    float uu = -0.1687  * rgb.r - 0.3313  * rgb.g + 0.5000  * rgb.b + 0.5;
    float vv =  0.5000  * rgb.r - 0.4187  * rgb.g - 0.0813  * rgb.b + 0.5;

    // saturation on UV channels
    uu = (uu - 0.5) * SAT + 0.5;
    vv = (vv - 0.5) * SAT + 0.5;

    return float4(yy, uu, vv, 1.0);
}
