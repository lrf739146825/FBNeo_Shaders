#pragma parameter OutputGamma "CRT - Output Gamma" 2.2 0.0 5.0 0.1
#pragma parameter PHOSPHOR "CRT - Phosphor ON/OFF" 1.0 0.0 1.0 1.0
#pragma parameter COLOR_BOOST "CRT - Color Boost" 1.5 1.0 2.0 0.05
#pragma parameter RED_BOOST "CRT - Red Boost" 1.0 1.0 2.0 0.01
#pragma parameter GREEN_BOOST "CRT - Green Boost" 1.0 1.0 2.0 0.01
#pragma parameter BLUE_BOOST "CRT - Blue Boost" 1.0 1.0 2.0 0.01
#pragma parameter SCANLINES_STRENGTH "CRT - Scanline Strength" 0.72 0.0 1.0 0.02
#pragma parameter BEAM_MIN_WIDTH "CRT - Min Beam Width" 0.86 0.0 1.0 0.02
#pragma parameter BEAM_MAX_WIDTH "CRT - Max Beam Width" 1.0 0.0 1.0 0.02

uniform float OutputGamma        = 2.2;
uniform float PHOSPHOR           = 1.0;
uniform float COLOR_BOOST        = 1.5;
uniform float RED_BOOST          = 1.0;
uniform float GREEN_BOOST        = 1.0;
uniform float BLUE_BOOST         = 1.0;
uniform float SCANLINES_STRENGTH = 0.72;
uniform float BEAM_MIN_WIDTH     = 0.86;
uniform float BEAM_MAX_WIDTH     = 1.0;

#define GAMMA_OUT(color) pow(color, float3(1.0 / OutputGamma, 1.0 / OutputGamma, 1.0 / OutputGamma))

struct input
{
    float2 video_size;
    float2 texture_size;
    float2 output_size;
    float frame_count;
    float frame_direction;
};

struct out_vertex
{
    float4 position : POSITION;
    float4 color    : COLOR;
    float2 texCoord : TEXCOORD0;
};

out_vertex main_vertex
(
    float4 position : POSITION,
    float4 color    : COLOR,
    float2 texCoord : TEXCOORD0,
    uniform float4x4 modelViewProj
)
{
    out_vertex OUT;
    OUT.position = mul(modelViewProj, position);
    OUT.color    = color;
    OUT.texCoord = texCoord;
    return OUT;
}

float4 main_fragment
(
    in out_vertex VAR,
    uniform sampler2D decal : TEXUNIT0,
    uniform input IN
) : COLOR
{
    float2 uv_ratio = float2(IN.video_size.x / IN.texture_size.x,
                             IN.video_size.y / IN.texture_size.y);
    float2 vTex = float2(VAR.texCoord.x / uv_ratio.x, VAR.texCoord.y / uv_ratio.y);

    float2 texture_size = float2(IN.video_size.x, IN.video_size.y);

    float2 dy = float2(0.0, 1.0 / texture_size.y);
    float2 pix_coord = float2(vTex.x * texture_size.x,
                              vTex.y * texture_size.y + 0.5);

    float2 tc = float2(floor(pix_coord.x) / texture_size.x,
                       (floor(pix_coord.y) + 0.5) / texture_size.y);
    float2 fp = frac(pix_coord);

    float3 color0 = tex2D(decal, float2(tc.x * uv_ratio.x, (tc.y - dy.y) * uv_ratio.y)).xyz;
    float3 color1 = tex2D(decal, float2(tc.x * uv_ratio.x, tc.y * uv_ratio.y)).xyz;

    float pos0 = fp.y;
    float pos1 = 1.0 - fp.y;

    float3 lum0 = lerp(float3(BEAM_MIN_WIDTH, BEAM_MIN_WIDTH, BEAM_MIN_WIDTH),
                       float3(BEAM_MAX_WIDTH, BEAM_MAX_WIDTH, BEAM_MAX_WIDTH), color0);
    float3 lum1 = lerp(float3(BEAM_MIN_WIDTH, BEAM_MIN_WIDTH, BEAM_MIN_WIDTH),
                       float3(BEAM_MAX_WIDTH, BEAM_MAX_WIDTH, BEAM_MAX_WIDTH), color1);

    float3 d0 = clamp(float3(pos0, pos0, pos0) / (lum0 + 0.0000001),
                      float3(0.0, 0.0, 0.0), float3(1.0, 1.0, 1.0));
    float3 d1 = clamp(float3(pos1, pos1, pos1) / (lum1 + 0.0000001),
                      float3(0.0, 0.0, 0.0), float3(1.0, 1.0, 1.0));

    d0 = exp(float3(-10.0, -10.0, -10.0) * SCANLINES_STRENGTH * d0 * d0);
    d1 = exp(float3(-10.0, -10.0, -10.0) * SCANLINES_STRENGTH * d1 * d1);

    float3 color = clamp(color0 * d0 + color1 * d1,
                         float3(0.0, 0.0, 0.0), float3(1.0, 1.0, 1.0));

    color = color * (COLOR_BOOST * float3(RED_BOOST, GREEN_BOOST, BLUE_BOOST));

    float mod_factor = vTex.x * IN.output_size.x;

    float3 dotMaskWeights = lerp(float3(1.0, 0.7, 1.0),
                                 float3(0.7, 1.0, 0.7),
                                 floor(fmod(mod_factor, 2.0)));

    color = color * lerp(float3(1.0, 1.0, 1.0), dotMaskWeights, PHOSPHOR);

    color = GAMMA_OUT(color);

    return float4(color.x, color.y, color.z, 1.0);
}
