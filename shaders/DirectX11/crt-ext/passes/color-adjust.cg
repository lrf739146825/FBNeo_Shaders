
#pragma parameter NTSCintensity "NTSC Color intensity" 0.0 0.0 1.0 0.1
#pragma parameter BLK "Black Level (IRE)" 2.0 -7.5 7.5 0.5
#pragma parameter EXPOSURE "Exposure" 1.0 0.1 2.0 0.05
#pragma parameter CT "Color Temperature Adjust (K)" 1000.0 -2800.0 2800.0 100.0
#pragma parameter DOT_GAMMA "Gamma Emulated" 2.2 1.0 4.0 0.1

uniform float NTSCintensity = 0.0;
uniform float BLK           = 2.0;
uniform float EXPOSURE      = 1.0;
uniform float CT            = 1000.0;
uniform float DOT_GAMMA     = 2.2;

#define DisplayCT 6500.0   // Displayer color temperature estimated

struct input
{
    float2 video_size;
    float2 texture_size;
    float2 output_size;
    float frame_count;
    float frame_direction;
};

struct out_vertex
{
    float4 position : POSITION;
    float4 color    : COLOR;
    float2 texCoord : TEXCOORD0;
};

out_vertex main_vertex
(
    float4 position : POSITION,
    float4 color    : COLOR,
    float2 texCoord : TEXCOORD0,
    uniform float4x4 modelViewProj
)
{
    out_vertex OUT;
    OUT.position = mul(modelViewProj, position);
    OUT.color    = color;
    OUT.texCoord = texCoord;
    return OUT;
}

/* NTSC Color */
float3 NTSCtoSRGB(float3 c)
{
    float3x3 NTSCtoXYZ = float3x3(
        0.6068909,  0.1735011,  0.2003480,
        0.2989164,  0.5865990,  0.1144845,
        0.0000000,  0.0660957,  1.1162243);

    float3x3 XYZtoSRGB = float3x3(
         3.2404542, -1.5371385, -0.4985314,
        -0.9692660,  1.8760108,  0.0415560,
         0.0556434, -0.2040259,  1.0572252);

    float3 v = mul(NTSCtoXYZ, pow(c, float3(2.2)));
    v = clamp(v, 0.0, 1.0);
    v = mul(XYZtoSRGB, v);
    v = clamp(v, 0.0, 1.0);
    return pow(v, float3(1.0 / 2.2));
}

/* Color Temperature */
float3 colorTemperatureToRGB(float temperature)
{
    float3x3 m = (temperature > DisplayCT) ?
        float3x3(
            1745.0425298314172, 1216.6168361476490, -8257.7997278925690,
            -2666.3474220535695, -2173.1012343082230, 2575.2827530017594,
            0.55995389139931482, 0.70381203140554553, 1.8993753891711275) :
        float3x3(
            0.0, -2902.1955373783176, -8257.7997278925690,
            0.0, 1669.5803561666639, 2575.2827530017594,
            1.0, 1.3302673723350029, 1.8993753891711275);

    float3 col = clamp(m[0] / (float3(temperature) + m[1]) + m[2], 0.0, 1.0);
    return lerp(col, float3(1.0, 1.0, 1.0), smoothstep(1000.0, 0.0, temperature));
}

float4 main_fragment
(
    in out_vertex VAR,
    uniform sampler2D decal : TEXUNIT0,
    uniform input IN
) : COLOR
{
    float2 vTexCoord = VAR.texCoord;

    float3 col0 = tex2D(decal, vTexCoord).rgb;

    if (NTSCintensity > 0.01)
        // NTSC Color
        col0 = lerp(col0, NTSCtoSRGB(col0), NTSCintensity);

    col0 = (col0 - (BLK * 0.01)) * (100.0 / (100.0 - BLK));    // Black Level Adjust
    col0 = clamp(col0 * EXPOSURE, 0.0, 1.0);

    float3 col1 = col0;
    if (CT != 0.0)
    {
        // Temperature
        col1 = col0 * colorTemperatureToRGB(DisplayCT + CT);
        col1 *= dot(col0, float3(0.2126, 0.7152, 0.0722)) / max(dot(col1, float3(0.2126, 0.7152, 0.0722)), 1e-5);   // Luminance Preservation
    }

    return float4(pow(col1, float3(DOT_GAMMA)), 1.0);
}
