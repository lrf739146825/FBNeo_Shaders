
struct input
{
    float2 video_size;
    float2 texture_size;
    float2 output_size;
    float frame_count;
    float frame_direction;
};

struct out_vertex
{
    float4 position : POSITION;
    float4 color    : COLOR;
    float2 texCoord : TEXCOORD0;
};

out_vertex main_vertex
(
    float4 position : POSITION,
    float4 color    : COLOR,
    float2 texCoord : TEXCOORD0,
    uniform float4x4 modelViewProj
)
{
    out_vertex OUT;
    OUT.position = mul(modelViewProj, position);
    OUT.color    = color;
    OUT.texCoord = texCoord;
    return OUT;
}

float3 fetch_v(sampler2D src, float2 uv, float4 sz, float2 ratio)
{
    float by = uv.y * sz.y - 0.5;
    float fy = by - floor(by);

    float ty0 = (floor(by) + 0.5) * sz.w;
    float ty1 = ty0 + sz.w;
    float tx  = uv.x;

    float3 c0 = tex2D(src, float2(tx * ratio.x, ty0 * ratio.y)).rgb;
    float3 c1 = tex2D(src, float2(tx * ratio.x, ty1 * ratio.y)).rgb;

    c0 = c0 * c0;
    c1 = c1 * c1;

    return lerp(c0, c1, fy);
}

float4 main_fragment
(
    in out_vertex VAR,
    uniform sampler2D decal : TEXUNIT0,
    uniform input IN
) : COLOR
{
    float video_w = IN.video_size.x;
    float video_h = IN.video_size.y;
    float r_x = video_w / IN.texture_size.x;
    float r_y = video_h / IN.texture_size.y;
    float u = VAR.texCoord.x / r_x;
    float v = VAR.texCoord.y / r_y;
    float4 srcSz = float4(video_w, video_h, 1.0 / video_w, 1.0 / video_h);
    float2 ratio = float2(r_x, r_y);

    float cs[5];
    cs[0] = 0.218663;
    cs[1] = 0.188942;
    cs[2] = 0.121895;
    cs[3] = 0.058715;
    cs[4] = 0.021117;

    float fx = u - 0.5;
    float fy = (v - 0.5) * 1.0527;
    float gStep = srcSz.z * 1.6;               // note: GLSL uses SourceSize.z (1/width)
    gStep *= 1.0 + (fx * fx + fy * fy) * 0.5;
    float cX = fx + 0.5;
    float cY = fy + 0.5;
    float2 dCenter = float2(cX, cY);

    float3 acc = fetch_v(decal, dCenter, srcSz, ratio) * cs[0];

    [unroll] for (int i = 1; i < 5; ++i)
    {
        float off = float(i) * gStep;
        float2 uvP = float2(cX, cY + off);
        float2 uvN = float2(cX, cY - off);
        acc += fetch_v(decal, uvP, srcSz, ratio) * cs[i];
        acc += fetch_v(decal, uvN, srcSz, ratio) * cs[i];
    }

    float3 tint = float3(0.56, 0.71, 1.0);
    float3 outCol = sqrt(clamp(acc * tint, 0.0, 1.0));
    return float4(outCol.x, outCol.y, outCol.z, 1.0);
}
